<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- All traffic must use TLS. Google APIs only; no user content leaves the
         device except the encrypted backup archive. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
